# ─── Core ────────────────────────────────────────────────────────
NODE_ENV=development          # development | staging | production
PORT=4000

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infopath_dev

# ─── Authentication ──────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN_SECONDS=86400
JWT_COOKIE_NAME=infopath_api_token
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ─── Platform Super-Admin (auto-provisioned on startup) ──────────
PLATFORM_SUPERADMIN_USERNAME=superadmin
PLATFORM_SUPERADMIN_PASSWORD=CHANGE_ME
PLATFORM_SUPERADMIN_FULL_NAME=Platform Superadmin

# ─── CORS ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_DEFAULT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX_REQUESTS=240

# ─── Swagger / Docs ─────────────────────────────────────────────
ENABLE_SWAGGER=true

# ─── Billing ─────────────────────────────────────────────────────
PREMIUM_MONTHLY_PRICE=299

# ─── Observability ───────────────────────────────────────────────
LOG_ALL_REQUESTS=false
